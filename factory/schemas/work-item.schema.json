{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-factory.local/schemas/work-item.schema.json",
  "title": "Software Factory work item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "priority",
    "workflowStatus",
    "triageStatus",
    "scopeApproval",
    "dependencies",
    "acceptanceCriteria",
    "runReferences"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1 },
    "category": { "enum": ["incident", "issue", "planbaar-werk"] },
    "priority": { "type": "integer", "minimum": 0 },
    "workflowStatus": { "enum": ["ready", "in-progress", "blocked", "done"] },
    "triageStatus": {
      "enum": [
        "needs-triage",
        "needs-info",
        "ready-for-agent",
        "ready-for-human",
        "wontfix"
      ]
    },
    "scopeApproval": { "enum": ["approved", "pending", "rejected"] },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "runReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
